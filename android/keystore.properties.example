# Copy this file to `android/keystore.properties` (which is gitignored) and
# fill in the values for the Play upload keystore.
#
# Generate the keystore once, and keep the .jks/.keystore file + these
# passwords backed up somewhere safe and OUT of the repo. Losing the upload
# key means asking Google to reset it (Play App Signing must be enabled).
#
#   keytool -genkeypair -v \
#     -keystore /secure/path/peekapiece-upload.keystore \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the `android/` directory. Point it
# somewhere OUTSIDE this repo (an absolute path is fine on your build
# machine), e.g. storeFile=C:/keys/peekapiece-upload.keystore

storeFile=/absolute/path/to/peekapiece-upload.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
